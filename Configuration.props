<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>preview</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>

		<EnableNetAnalyzers>true</EnableNetAnalyzers>
		<AnalysisMode>recommended</AnalysisMode>
		<NoWarn>$(NoWarn);CA1822;CA2255</NoWarn> <!-- #net10 -->
	</PropertyGroup>

	<PropertyGroup>
		<SolutionDir>$(MSBuildThisFileDirectory)</SolutionDir>
		<SourceDir>$(SolutionDir)src/</SourceDir>

		<LibsDir>$(SolutionDir)lib/</LibsDir>
		<AssemblySearchPaths>
			$(AssemblySearchPaths);
			$(LibsDir);
		</AssemblySearchPaths>

		<OutputPath>$(SolutionDir)bin/</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>

	<ItemDefinitionGroup>
		<Reference Private="false" />
		<ProjectReference Private="false" />
		<PackageReference PrivateAssets="all" />
	</ItemDefinitionGroup>

	<ItemGroup>
		<!-- NOTE: Copy/symlink these from Managed/ to lib/ -->
		<Reference Include="Assembly-CSharp" Publicize="true" />
		<Reference Include="Assembly-CSharp-firstpass" />
		<Reference Include="MoonsharpDef" />
		<Reference Include="Utilities" />

		<PackageReference Include="BepInEx.Analyzers"                  Version="1.*" />
		<PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" />
		<PackageReference Include="BepInEx.Core"                       Version="5.*" />
		<PackageReference Include="BepInEx.PluginInfoProps"            Version="1.*" />
		<PackageReference Include="UnityEngine.Modules"                Version="2019.4.40" IncludeAssets="compile" />

		<PackageReference Include="Polyfill"  Version="7.32.0" />
		<!--
		<PackageReference Include="PolySharp" Version="1.15.0" />
		-->
	</ItemGroup>

</Project>
